# Claude Ads Stack — API Keys
# Copy this file to .env and fill in your keys

# ── Image Generation ──────────────────────────────────────────
# Higgsfield (primary — already connected via MCP, no key needed here)
# HIGGSFIELD_API_KEY=

# OpenAI GPT-image-2 — enables /chatgpt-image-ad skill
OPENAI_API_KEY=

# Google Gemini — enables /nano-banana-image-ad fallback
GOOGLE_API_KEY=

# ── Video Generation ──────────────────────────────────────────
# Arcads API — enables /arcads-external-api (Veo 3.1, Seedance 2, Sora 2, Kling)
# Get key at: arcads.ai
ARCADS_API_KEY=

# ── Social Publishing ─────────────────────────────────────────
# Zernio — enables /ads publish to 14+ social networks
# Get key at: zernio.com
ZERNIO_API_KEY=

# ── Meta Ads API ──────────────────────────────────────────────
# Required for /ad-upload, /meta-ads, /ad-creative-monitor
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# ── Google Ads API ────────────────────────────────────────────
# Required for /ads google live account audit
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
